# Single-user local deployment. Never commit a filled .env.
CAREER_DB_PATH=/data/career.db
CAREER_OWNER=personal
CAREER_ACCESS_TOKEN=
# Optional API integrations, all inactive unless explicitly configured
APOLLO_API_KEY=
GMAIL_ACCESS_TOKEN=
GMAIL_SENDER_ADDRESS=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ENABLE_PAID_PROVIDERS=false
MAX_MONTHLY_PAID_USD=0
ENABLE_AUTO_EMAIL=false
