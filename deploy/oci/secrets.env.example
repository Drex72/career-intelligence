# Copy this template to secrets.env on the VM, then chmod 600.
# Never commit secrets.env, share it in chat, or use the transaction pooler (6543).
# Paste the full Supabase Session Pooler connection string from Dashboard > Connect.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REFERENCE:YOUR_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
# Use the EXISTING worker HMAC shared_key from secure infrastructure configuration.
CI_WORKER_SIGNING_KEY=REPLACE_WITH_EXISTING_SIGNING_KEY
# This endpoint is nonsecret; requests must still carry valid role-specific HMAC.
CI_WORKER_ENDPOINT=https://manqpbwiwmzqxgldhbdt.supabase.co/functions/v1/ci-worker
CI_POLL_SECONDS=30
CI_MAX_DISPATCH_PER_CYCLE=2
LANGGRAPH_STRICT_MSGPACK=true
